# Plantilla de variables de entorno. Copia este archivo como ".env"
# y rellena los valores reales (nunca subas el .env real a Git).

# Catalog.API -> Postgres en Railway
CATALOG_DB_HOST=
CATALOG_DB_PORT=
CATALOG_DB_PASSWORD=

# Basket.API -> Postgres en Railway
BASKET_DB_HOST=
BASKET_DB_PORT=
BASKET_DB_PASSWORD=

# Basket.API -> Redis en Railway
BASKET_REDIS_HOST=
BASKET_REDIS_PORT=
BASKET_REDIS_PASSWORD=

# Orders.API -> MongoDB Atlas
# Debe incluir el nombre de la base al final, ej: .../OrdersDb?appName=...
MONGO_CONNECTION_STRING=
